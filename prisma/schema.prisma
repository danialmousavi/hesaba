generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum FiscalYearEventType {
  CREATED
  CLOSED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum JournalEntryKind {
  NORMAL
  CLOSING_TEMPORARY
  CLOSING_PERMANENT
  OPENING
}

enum ProductType {
  GOODS
  SERVICE
}

enum PartyAccountPurpose {
  RECEIVABLE
  PAYABLE
}

enum PartyAccountEventType {
  LINKED
  UNLINKED
  CHANGED
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

enum FinancialTransactionStatus {
  DRAFT
  POSTED
}

enum FinancialPaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentType {
  RECEIPT
  PAYMENT
}

enum PaymentStatus {
  DRAFT
  POSTED
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  activeSessions Session[] @relation("SessionActiveOrganization")
  fiscalYears FiscalYear[]
  fiscalYearEvents FiscalYearEvent[]
  ledgerAccounts LedgerAccount[]
  journalEntries JournalEntry[]
  journalEvents  JournalEvent[]
  parties        Party[]
  products       Product[]
  partyAccountEvents PartyAccountEvent[]
  financialTransactions FinancialTransaction[]
  invoices Invoice[]
  payments Payment[]
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           ProductType
  unit           String
  salePrice      Decimal      @db.Decimal(20, 0)
  purchasePrice  Decimal?     @db.Decimal(20, 0)
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoiceLines   InvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([organizationId, type, isActive])
}

model Party {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isCustomer     Boolean      @default(false)
  isSupplier     Boolean      @default(false)
  phone          String?
  email          String?
  address        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accountLinks   PartyAccount[]
  accountEvents  PartyAccountEvent[]
  invoices       Invoice[]
  payments       Payment[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, isCustomer, isActive])
  @@index([organizationId, isSupplier, isActive])
}

model PartyAccount {
  id             String              @id @default(cuid())
  organizationId String
  partyId        String
  accountId      String
  purpose        PartyAccountPurpose
  firstUsedAt    DateTime?
  createdAt      DateTime            @default(now())
  party          Party               @relation(fields: [organizationId, partyId], references: [organizationId, id], onDelete: Restrict)
  account        LedgerAccount       @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, partyId, purpose])
  @@unique([organizationId, accountId])
}

model PartyAccountEvent {
  id             String                @id @default(cuid())
  organizationId String
  partyId        String
  purpose        PartyAccountPurpose
  type           PartyAccountEventType
  actorId        String
  actorName      String
  oldAccountId   String?
  newAccountId   String?
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party          Party                 @relation(fields: [organizationId, partyId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, partyId, createdAt])
}

model JournalEvent {
  id             String       @id @default(cuid())
  organizationId String
  entryId        String
  actorId        String
  actorName      String
  action         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entry          JournalEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, entryId, createdAt])
}

model LedgerAccount {
  id             String            @id @default(cuid())
  organizationId String
  parentId       String?
  code           String
  name           String
  type           LedgerAccountType
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         LedgerAccount?    @relation("LedgerAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       LedgerAccount[]   @relation("LedgerAccountHierarchy")
  journalLines   JournalLine[]
  partyLinks     PartyAccount[]
  financialCategories FinancialTransaction[] @relation("FinancialCategory")
  financialSettlements FinancialTransaction[] @relation("FinancialSettlement")
  payments Payment[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, parentId])
  @@index([organizationId, type, isActive])
}

model FiscalYearEvent {
  id             String              @id @default(cuid())
  organizationId String
  fiscalYearId   String
  actorId        String
  actorName      String
  type           FiscalYearEventType
  details        Json
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, fiscalYearId, createdAt])
}

model FiscalYear {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  status         FiscalYearStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  financialTransactions FinancialTransaction[]
  invoices Invoice[]
  payments Payment[]
  closingSource FiscalClosing? @relation("ClosingSource")
  closingTarget FiscalClosing? @relation("ClosingTarget")

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, startDate])
}

model JournalEntry {
  id             String             @id @default(cuid())
  organizationId String
  fiscalYearId   String
  number         Int
  date           DateTime           @db.Date
  description    String
  status         JournalEntryStatus @default(DRAFT)
  kind           JournalEntryKind @default(NORMAL)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear         @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Restrict)
  lines          JournalLine[]
  events         JournalEvent[]
  financialTransaction FinancialTransaction?
  invoice Invoice?
  payment Payment?
  reversal JournalReversal? @relation("OriginalJournal")
  reversalOf JournalReversal? @relation("ReversalJournal")
  invoiceCancellation InvoiceCancellation?
  closingTemporary FiscalClosing? @relation("ClosingTemporary")
  closingPermanent FiscalClosing? @relation("ClosingPermanent")
  closingOpening FiscalClosing? @relation("ClosingOpening")

  @@unique([organizationId, fiscalYearId, number])
  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, id])
  @@index([organizationId, date])
}

model FiscalClosing {
  id               String @id @default(cuid())
  organizationId   String
  sourceYearId     String
  targetYearId     String
  temporaryEntryId String?
  permanentEntryId String?
  openingEntryId   String?
  requestKey       String
  requestHash      String
  previewFingerprint String
  actorId          String
  actorName        String
  summary          Json
  createdAt        DateTime @default(now())
  sourceYear FiscalYear @relation("ClosingSource", fields: [organizationId, sourceYearId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  targetYear FiscalYear @relation("ClosingTarget", fields: [organizationId, targetYearId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  temporaryEntry JournalEntry? @relation("ClosingTemporary", fields: [organizationId, sourceYearId, temporaryEntryId], references: [organizationId, fiscalYearId, id], onDelete: Restrict, onUpdate: Restrict)
  permanentEntry JournalEntry? @relation("ClosingPermanent", fields: [organizationId, sourceYearId, permanentEntryId], references: [organizationId, fiscalYearId, id], onDelete: Restrict, onUpdate: Restrict)
  openingEntry JournalEntry? @relation("ClosingOpening", fields: [organizationId, targetYearId, openingEntryId], references: [organizationId, fiscalYearId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, requestKey])
  @@unique([organizationId, sourceYearId])
  @@unique([organizationId, targetYearId])
  @@unique([organizationId, sourceYearId, temporaryEntryId])
  @@unique([organizationId, sourceYearId, permanentEntryId])
  @@unique([organizationId, targetYearId, openingEntryId])
}

model FinancialTransaction {
  id                  String                     @id @default(cuid())
  organizationId      String
  fiscalYearId        String
  type                FinancialTransactionType
  status              FinancialTransactionStatus @default(DRAFT)
  date                DateTime                   @db.Date
  amount              Decimal                    @db.Decimal(20, 0)
  description         String
  paymentMethod       FinancialPaymentMethod
  categoryAccountId   String
  settlementAccountId String
  journalEntryId      String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear          FiscalYear                 @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Restrict)
  categoryAccount     LedgerAccount              @relation("FinancialCategory", fields: [organizationId, categoryAccountId], references: [organizationId, id], onDelete: Restrict)
  settlementAccount   LedgerAccount              @relation("FinancialSettlement", fields: [organizationId, settlementAccountId], references: [organizationId, id], onDelete: Restrict)
  journalEntry        JournalEntry?              @relation(fields: [organizationId, fiscalYearId, journalEntryId], references: [organizationId, fiscalYearId, id], onDelete: Restrict, map: "FinancialTransaction_org_year_entry_fkey")

  @@unique([organizationId, journalEntryId])
  @@unique([organizationId, fiscalYearId, journalEntryId], map: "FinancialTransaction_org_year_entry_key")
  @@index([organizationId, fiscalYearId, date])
  @@index([organizationId, type, status])
}

model JournalLine {
  id             String        @id @default(cuid())
  organizationId String
  entryId        String
  accountId      String
  description    String?
  debit          Decimal       @default(0) @db.Decimal(20, 0)
  credit         Decimal       @default(0) @db.Decimal(20, 0)
  entry          JournalEntry  @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  account        LedgerAccount @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, entryId])
  @@index([organizationId, accountId])
}

model JournalReversal {
  organizationId  String
  sourceEntryId   String
  reversalEntryId String
  actorId         String
  actorName       String
  createdAt       DateTime     @default(now())
  source          JournalEntry @relation("OriginalJournal", fields: [organizationId, sourceEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "JournalReversal_source_fkey")
  reversal        JournalEntry @relation("ReversalJournal", fields: [organizationId, reversalEntryId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "JournalReversal_reversal_fkey")

  @@id([organizationId, sourceEntryId])
  @@unique([organizationId, reversalEntryId])
}

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String
  fiscalYearId     String
  customerId       String
  customerName     String
  date             DateTime      @db.Date
  status           InvoiceStatus @default(DRAFT)
  description      String?
  revision         Int           @default(0)
  number           Int?
  journalEntryId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear       FiscalYear    @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Restrict)
  customer         Party         @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  journalEntry     JournalEntry? @relation(fields: [organizationId, fiscalYearId, journalEntryId], references: [organizationId, fiscalYearId, id], onDelete: Restrict, map: "Invoice_org_year_entry_fkey")
  lines            InvoiceLine[]
  allocations      PaymentAllocation[]
  cancellation     InvoiceCancellation?

  @@unique([organizationId, id])
  @@unique([organizationId, customerId, id], map: "Invoice_org_customer_id_key")
  @@unique([organizationId, fiscalYearId, number])
  @@unique([organizationId, fiscalYearId, journalEntryId], map: "Invoice_org_year_entry_key")
  @@index([organizationId, fiscalYearId, date])
  @@index([organizationId, customerId, status])
}

model InvoiceCancellation {
  organizationId  String
  invoiceId       String
  reversalEntryId String
  reason          String
  actorId         String
  actorName       String
  createdAt       DateTime     @default(now())
  invoice         Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "InvoiceCancellation_invoice_fkey")
  reversalEntry   JournalEntry @relation(fields: [organizationId, reversalEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "InvoiceCancellation_journal_fkey")

  @@id([organizationId, invoiceId])
  @@unique([organizationId, reversalEntryId])
}

model InvoiceLine {
  id             String      @id @default(cuid())
  organizationId String
  invoiceId      String
  productId      String
  position       Int
  productCode    String
  productName    String
  productType    ProductType
  unit           String
  quantity       Decimal     @db.Decimal(18, 3)
  unitPrice      Decimal     @db.Decimal(20, 0)
  discountAmount Decimal     @default(0) @db.Decimal(20, 0)
  taxAmount      Decimal     @default(0) @db.Decimal(20, 0)
  invoice        Invoice     @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  product        Product     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, invoiceId, position])
  @@index([organizationId, productId])
}

model Payment {
  id                  String             @id @default(cuid())
  organizationId      String
  fiscalYearId        String
  partyId             String
  type                PaymentType
  status              PaymentStatus      @default(DRAFT)
  date                DateTime           @db.Date
  amount              Decimal            @db.Decimal(20, 0)
  method              FinancialPaymentMethod
  settlementAccountId String
  description         String?
  requestKey          String?
  requestHash         String?
  journalEntryId      String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear          FiscalYear         @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Restrict)
  party               Party              @relation(fields: [organizationId, partyId], references: [organizationId, id], onDelete: Restrict)
  settlementAccount   LedgerAccount      @relation(fields: [organizationId, settlementAccountId], references: [organizationId, id], onDelete: Restrict)
  journalEntry        JournalEntry?      @relation(fields: [organizationId, fiscalYearId, journalEntryId], references: [organizationId, fiscalYearId, id], onDelete: Restrict, map: "Payment_org_year_entry_fkey")
  allocations         PaymentAllocation[]

  @@unique([organizationId, partyId, id, type], map: "Payment_org_party_id_type_key")
  @@unique([organizationId, requestKey], map: "Payment_org_request_key")
  @@unique([organizationId, fiscalYearId, journalEntryId], map: "Payment_org_year_entry_key")
  @@index([organizationId, fiscalYearId, date])
  @@index([organizationId, partyId, type])
}

model PaymentAllocation {
  id             String      @id @default(cuid())
  organizationId String
  partyId        String
  paymentId      String
  paymentType    PaymentType @default(RECEIPT)
  invoiceId      String
  amount         Decimal     @db.Decimal(20, 0)
  createdAt      DateTime    @default(now())
  payment        Payment     @relation(fields: [organizationId, partyId, paymentId, paymentType], references: [organizationId, partyId, id, type], onDelete: Cascade, onUpdate: Restrict, map: "PaymentAllocation_payment_fkey")
  invoice        Invoice     @relation(fields: [organizationId, partyId, invoiceId], references: [organizationId, customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "PaymentAllocation_invoice_fkey")

  @@unique([organizationId, paymentId, invoiceId], map: "PaymentAllocation_org_payment_invoice_key")
  @@index([organizationId, invoiceId])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeOrganization Organization? @relation("SessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
